PORT=4000

# n8n webhook URLs (Production URLs from each workflow's Webhook node)
N8N_WEBHOOK_URL=https://your-n8n-host/webhook/hotel-chat
N8N_ESCALATE_URL=https://your-n8n-host/webhook/hotel-escalate
N8N_INGEST_URL=https://your-n8n-host/webhook/hotel-knowledge-ingest

# Lets the admin PDF upload write to the knowledge base. Keep false unless the
# admin routes are protected or you are running locally.
ENABLE_PDF_INGEST=false
