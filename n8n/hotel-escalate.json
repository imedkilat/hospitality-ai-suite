      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "function escapeHtml(str) {\n  if (!str) return '';\n  return String(str)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;');\n}\n\n// Change this to the address that should receive unanswered guest questions.\nconst ESCALATION_RECIPIENT = 'hotel-staff@example.com';\n\nconst data = $('Normalize Input').item.json;\n\nconst sessionId = data.sessionId || 'N/A';\nconst question = data.question || 'N/A';\nconst name = data.name || 'N/A';\nconst email = data.email || 'N/A';\nconst phone = data.phone || 'N/A';\nconst conversation = Array.isArray(data.conversation) ? data.conversation : [];\n\nconst lines = conversation.map((m, i) => {\n  const from = m.from || 'unknown';\n  const text = m.text || '';\n  return `${i + 1}. [${from}] ${text}`;\n});\n\nconst textBody = [\n  'Unanswered question from the hotel assistant',\n  '',\n  `Session ID: ${sessionId}`,\n  '',\n  'Guest details:',\n  `Name: ${name}`,\n  `Email: ${email}`,\n  `Phone: ${phone}`,\n  '',\n  'Question the bot could not answer:',\n  question,\n  '',\n  'Conversation transcript:',\n  ...lines,\n].join('\\n');\n\nconst htmlLines = conversation.map((m) => {\n  const from = escapeHtml(m.from || 'unknown');\n  const text = escapeHtml(m.text || '');\n  return `<li><strong>[${from}]</strong> ${text}</li>`;\n});\n\nlet transcriptHtml;\nif (htmlLines.length) {\n  transcriptHtml = `<ol style=\"margin-top: 4px; padding-left: 20px;\">${htmlLines.join('')}</ol>`;\n} else {\n  transcriptHtml = '<p style=\"margin-top: 4px; color: #777;\">No transcript available.</p>';\n}\n\nconst htmlBody = `\n<div style=\"font-family: Arial, sans-serif; line-height: 1.6; color: #222;\">\n  <h2 style=\"margin-bottom: 8px;\">Hotel assistant escalation</h2>\n  <p style=\"margin-top: 0; font-size: 14px; color: #555;\">\n    The chatbot could not answer a guest question. Details below.\n  </p>\n  <hr style=\"border: none; border-top: 1px solid #ddd; margin: 16px 0;\" />\n  <p><strong>Session ID:</strong> ${escapeHtml(sessionId)}</p>\n  <h3 style=\"margin-bottom: 4px;\">Guest details</h3>\n  <ul style=\"margin-top: 4px;\">\n    <li><strong>Name:</strong> ${escapeHtml(name)}</li>\n    <li><strong>Email:</strong> ${escapeHtml(email)}</li>\n    <li><strong>Phone:</strong> ${escapeHtml(phone)}</li>\n  </ul>\n  <h3 style=\"margin-bottom: 4px;\">Unanswered question</h3>\n  <p style=\"margin-top: 4px;\">${escapeHtml(question)}</p>\n  <h3 style=\"margin-bottom: 4px;\">Conversation transcript</h3>\n  ${transcriptHtml}\n</div>\n`;\n\nreturn [\n  {\n    json: {\n      to: ESCALATION_RECIPIENT,\n      subject: `Unanswered question: ${question.slice(0, 60) || 'Hotel assistant'}`,\n      textBody,\n      htmlBody,\n    },\n  },\n];\n"
      },
